# Ячейка 1: Импорт библиотек и проверка памяти
import pandas as pd
import numpy as np
import psutil
import matplotlib.pyplot as plt
import seaborn as sns
from ydata_profiling import ProfileReport

vm = psutil.virtual_memory()
print(f"💻 Всего оперативной памяти: {vm.total / (1024**3):.2f} ГБ")
print(f"✅ Доступно прямо сейчас: {vm.available / (1024**3):.2f} ГБ")
print(f"📊 Используется: {vm.percent}%")

# Ячейка 2: Загрузка и строгое разделение данных
FILE_PATH = "../data/raw/train.csv" # Путь к исходному файлу
HOLD_OUT_SIZE = 1_000_000

print(f"💾 Свободно ОЗУ: {psutil.virtual_memory().available / (1024**3):.1f} ГБ")

df = pd.read_csv(FILE_PATH)
train_df = df.iloc[:-HOLD_OUT_SIZE].copy().reset_index(drop=True)
test_df = df.iloc[-HOLD_OUT_SIZE:].copy().reset_index(drop=True)
del df

def safe_downcast(df):
    for col in df.select_dtypes(include=['integer']).columns:
        df[col] = pd.to_numeric(df[col], downcast='integer')
    for col in df.select_dtypes(include=['floating']).columns:
        df[col] = pd.to_numeric(df[col], downcast='float')
    for col in df.select_dtypes(include=['object', 'string']).columns:
        if df[col].nunique() < 50:
            df[col] = df[col].astype('category')
    return df

train_df = safe_downcast(train_df)
test_df = safe_downcast(test_df)

# Удаляем id и Response из test (защита от leakage)
train_df = train_df.drop('id', axis=1)
test_df = test_df.drop('id', axis=1)
test_target = test_df['Response'].copy()
test_df = test_df.drop('Response', axis=1)

print(f"✅ Train: {len(train_df):,} | Test: {len(test_df):,}")
print(f"💾 Память Train: {train_df.memory_usage(deep=True).sum() / (1024**2):.1f} МБ")

# Ячейка 3: Базовый EDA (Статистика и пропуски)
print("📊 ЧИСЛОВЫЕ ПРИЗНАКИ:")
display(train_df.describe().T)

cat_stats = pd.DataFrame({
    'Уникальных': train_df.select_dtypes(include=['category', 'object']).nunique(),
    'Примеры': train_df.select_dtypes(include=['category', 'object']).apply(lambda x: ', '.join(map(str, x.unique()[:5])))
})
print("\n📝 КАТЕГОРИАЛЬНЫЕ ПРИЗНАКИ:")
display(cat_stats)

missing = train_df.isnull().sum()
print(f"\n🔎 Пропуски: {'✅ Нет' if missing.sum() == 0 else '\n' + str(missing[missing > 0])}")
print(f"🎯 Доля класса 1: {(train_df['Response'].mean() * 100):.2f}%")

# Ячейка 4: Анализ аномалии Driving_License
no_license = train_df[train_df['Driving_License'] == 0]
print(f"📊 Всего без прав: {len(no_license):,} ({len(no_license)/len(train_df)*100:.2f}%)")
print(f"\n🎯 Распределение Response:")
print(no_license['Response'].value_counts())
print(f"\n📈 Доля Response=1: {no_license['Response'].mean()*100:.2f}%")
print(f"📈 Доля Response=1 в целом по датасету: {train_df['Response'].mean()*100:.2f}%")
# Вывод: Driving_License удален из финального набора признаков из-за низкой базы и ненадежности.

# Ячейка 5: Корреляционная матрица
num_cols = train_df.select_dtypes(include=[np.number]).columns.tolist()
num_cols = [c for c in num_cols if c != 'Response']

plt.figure(figsize=(10, 8))
corr_matrix = train_df[num_cols].corr()
sns.heatmap(corr_matrix, annot=False, cmap='coolwarm', center=0, linewidths=.5, square=True)
plt.title('Корреляционная матрица числовых признаков')
plt.tight_layout()
plt.show()

print("\nТоп-5 корреляций с Response:")
corr_with_target = train_df[num_cols + ['Response']].corr()['Response'].sort_values(ascending=False)
print(corr_with_target.iloc[1:6])
